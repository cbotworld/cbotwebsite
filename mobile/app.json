{
  "expo": {
    "name": "CBOT Live Stream",
    "slug": "cbot-live-stream",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cbotworld.livestream",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "CBOT needs camera access to record your Carrom board match.",
        "NSMicrophoneUsageDescription": "CBOT needs microphone access to record audio during the match."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.cbotworld.livestream",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "CBOT needs camera access to record your Carrom board match.",
          "microphonePermission": "CBOT needs microphone access to record audio during the match.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d02ff995-77f3-4af1-9e60-872919f3f500"
      }
    },
    "owner": "krackbotstudio"
  }
}
