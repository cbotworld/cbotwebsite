# ==============================================================================
# Dokploy Environment Configuration Template
# Copy and paste these into Dokploy -> Your App -> Environment Tab
# ==============================================================================

# Node Environment & Network
NODE_ENV=production
PORT=3006
HOSTNAME=0.0.0.0

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"

# NextAuth Authentication
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-secure-random-secret"
# The public domain assigned in Dokploy (e.g. https://cbot.yourdomain.com)
NEXTAUTH_URL="https://your-domain.com"

# Supabase (Optional for Storage & Auth integration)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# SMTP Mail Server (for OTP verification / email reports)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"

# Google Site Verification (SEO / Search Console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-verification-code"

# YouTube Live / Google OAuth Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.com/api/auth/youtube/callback"
GOOGLE_CLIENT_ID_2=""
GOOGLE_CLIENT_SECRET_2=""

# Mobile App Target Versions & Links
LATEST_IOS_VERSION="1.3"
LATEST_IOS_BUILD="30"
LATEST_ANDROID_VERSION="1.3.0"
LATEST_ANDROID_BUILD="30"
IOS_STORE_URL="https://apps.apple.com/app/id6742533036"
ANDROID_STORE_URL="https://play.google.com/store/apps/details?id=com.cbotworld"

# Optional: Set to true if you want the container to run `prisma db push` on startup
AUTO_DB_PUSH=false

