datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  name          String?
  email         String?   @unique
  pin           String    // hashed PIN
  isActivated   Boolean   @default(true)
  emailVerified DateTime?
  image         String?
  role          String    @default("PLAYER") // SUPER_ADMIN, ORGANIZER, CAPTAIN, PLAYER
  bio           String?
  
  // Location & Contact
  country       String?   @default("India")
  state         String?   @default("Tamil Nadu")
  city          String?   @default("Chennai")
  whatsApp      String?
  
  // Player Lifetime Stats
  rating        Int       @default(1200)
  wins          Int       @default(0)
  losses        Int       @default(0)
  queenStrikes  Int       @default(0)
  boardsWon     Int       @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  
  // Relations
  editionParticipants EditionParticipant[]
  captainedTeams      Team[]                 @relation("CaptainRelation")
  organizedEditions   Edition[]              @relation("OrganizerRelation")
  scoreReports        ScoreReport[]
  lineupSlots         MatchLineupSlotPlayer[]
  
  rankingSnapshots    PlayerRankingSnapshot[]
  hallOfFameEntries   HallOfFame[]
  categoryHistory     PlayerCategoryHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Edition {
  id                    String    @id @default(cuid())
  number                Int       @unique
  title                 String
  slug                  String    @unique
  theme                 String?
  themeDescription      String?
  themeHint             String?
  posterUrl             String?
  bannerImage           String?
  
  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  tournamentStartDate   DateTime?
  tournamentEndDate     DateTime?
  
  format                String    @default("SINGLE_ELIMINATION")
  status                String    @default("DRAFT")
  
  prizePool             String    @default("₹0 INR")
  maxTeams              Int       @default(16)
  rules                 String?
  
  organizerId           String
  organizer             User      @relation("OrganizerRelation", fields: [organizerId], references: [id])
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  teams                 Team[]
  matches               Match[]
  participants          EditionParticipant[]
  patterns              EditionBoardPattern[]
  
  rankingSnapshots      PlayerRankingSnapshot[]
  leagueStandings       LeagueStanding[]
  categoryHistory       PlayerCategoryHistory[]
}

model EditionParticipant {
  id            String    @id @default(cuid())
  editionId     String
  edition       Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  
  category      String?   
  startingRank  Int?
  status        String    @default("REGISTERED")
  result        String?   
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([editionId, userId])
}

model Team {
  id          String   @id @default(cuid())
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  name        String
  tag         String
  logo        String?
  description String?
  
  captainId   String?
  captain     User?    @relation("CaptainRelation", fields: [captainId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     EditionParticipant[]
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  wonMatches  Match[]  @relation("WonTeam")
  lineups     MatchLineup[]
  leagueStandings LeagueStanding[]
  
  @@unique([editionId, name])
  @@unique([editionId, tag])
}

model BoardPattern {
  id                  String   @id @default(cuid())
  name                String   @unique
  difficulty          String   @default("MEDIUM")
  objective           String
  validCoins          String   
  invalidCoins        String   
  
  basePoints          Int      @default(0)
  queenBonus          Int      @default(0)
  penaltyPoints       Int      @default(0)
  
  instructionalMedia  String?
  diagramUrl          String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  editionAssignments  EditionBoardPattern[]
}

model EditionBoardPattern {
  id              String       @id @default(cuid())
  editionId       String
  edition         Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  patternId       String
  pattern         BoardPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  
  sequence        Int
  matchFormat     String       
  
  @@unique([editionId, patternId])
  @@unique([editionId, sequence])
}

model Match {
  id            String      @id @default(cuid())
  editionId     String
  edition       Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  round         Int         @default(1)
  matchNumber   Int         @default(1)
  stage         String      @default("LEAGUE")
  
  team1Id       String?
  team1         Team?       @relation("HomeTeam", fields: [team1Id], references: [id])
  team2Id       String?
  team2         Team?       @relation("AwayTeam", fields: [team2Id], references: [id])
  
  score1        Int         @default(0)
  score2        Int         @default(0)
  queenStrikes1 Int         @default(0)
  queenStrikes2 Int         @default(0)
  
  status        String      @default("SCHEDULED")
  winnerId      String?
  winner        Team?       @relation("WonTeam", fields: [winnerId], references: [id])
  
  scheduledTime DateTime?
  tableNumber   Int?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  scoreReports  ScoreReport[]
  lineups       MatchLineup[]
}

model MatchLineup {
  id            String   @id @default(cuid())
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  status        String   @default("DRAFT")
  submittedAt   DateTime?
  lockedAt      DateTime?
  overrideNotes String?
  
  slots         MatchLineupSlot[]

  @@unique([matchId, teamId])
}

model MatchLineupSlot {
  id            String       @id @default(cuid())
  lineupId      String
  lineup        MatchLineup  @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  
  formatType    String       
  patternId     String       
  patternName   String
  
  players       MatchLineupSlotPlayer[]
}

model MatchLineupSlotPlayer {
  id            String          @id @default(cuid())
  slotId        String
  slot          MatchLineupSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([slotId, userId])
}

model ScoreReport {
  id                String   @id @default(cuid())
  matchId           String
  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  submittedByUserId String
  submittedBy       User     @relation(fields: [submittedByUserId], references: [id])
  
  team1Score        Int
  team2Score        Int
  queenStrikes1     Int      @default(0)
  queenStrikes2     Int      @default(0)
  
  proofNotes        String?
  proofUrl          String?
  
  status            String   @default("PENDING")
  
  createdAt         DateTime @default(now())
}

model PlayerRankingSnapshot {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  rating      Int
  globalRank  Int
  countryRank Int?
  category    String
  
  createdAt   DateTime @default(now())
  
  @@unique([userId, editionId])
}

model LeagueStanding {
  id          String   @id @default(cuid())
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  rank        Int
  played      Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  points      Int      @default(0)
  scoreDiff   Int      @default(0)
  queenStrikes Int     @default(0)
  
  createdAt   DateTime @default(now())
  
  @@unique([editionId, teamId])
}

model HallOfFame {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title         String
  achievement   String
  inductionYear Int
  
  createdAt     DateTime @default(now())
}

model PlayerCategoryHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  oldCategory String?
  newCategory String
  reason      String?
  
  createdAt   DateTime @default(now())
}
