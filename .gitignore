# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/sdks
.yarn/unplugged
.yarn/build-state.yml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
ehthumbs.db
*.log
/scratch/

# Nested Cbot copy is tracked (Cbot/mobile + Cbot/backend).
# Do not ignore /CBOT/ — on Windows that also hid Cbot/.
Cbot/**/node_modules/
Cbot/**/.expo/
Cbot/**/.claude/
Cbot/mobile/android/
Cbot/mobile/ios/
Cbot/mobile/modules/**/android/build/
Cbot/mobile/modules/**/android/.gradle/
Cbot/mobile/credentials.json
Cbot/mobile/*.jks
Cbot/mobile/*.keystore
Cbot/mobile/eas-build-log*
Cbot/mobile/eas-log-url.txt
Cbot/mobile/eas-build-view.utf8.json
Cbot/mobile/eas-build*
*.jks
*.keystore
keystore.properties
mobile/credentials/
*.bin

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment files & secrets
.env
.env*.local
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo

# Prisma generated outputs or sqlite databases if any
*.db
*.db-journal
